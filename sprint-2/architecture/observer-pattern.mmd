    style INJECTION fill:#F3E8FF,stroke:#8B5CF6,stroke-width:2px
    style ROUTER_LAYER fill:#F3E8FF,stroke:#8B5CF6,stroke-width:2px
    style OBSERVERS fill:#EDE9FE,stroke:#7C3AED,stroke-width:2px
    style REACTIVE fill:#ECFDF5,stroke:#10B981,stroke-width:2px
    style ONCHANGE fill:#FEF3C7,stroke:#F59E0B,stroke-width:2px
    style APP fill:#7C3AED,color:#FFFFFF
    style CLERK_ENV fill:#6D28D9,color:#FFFFFF
    style SESSION_ENV fill:#6D28D9,color:#FFFFFF
    style CONTENT fill:#7C3AED,color:#FFFFFF
    style ROUTER_ENV fill:#6D28D9,color:#FFFFFF
    style CHANGE fill:#10B981,color:#FFFFFF
    style NOTIFY fill:#059669,color:#FFFFFF
